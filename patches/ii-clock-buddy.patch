     }
 
     draggable: placementStrategy === "free"
+    // [buddy] suivre les changements de position écrits dans config.json (ex. par le compagnon)
+    Connections {
+        target: root.configEntry
+        function onXChanged() { if (root.placementStrategy === "free" && !root.pressed) root.targetX = Math.max(0, Math.min(root.configEntry.x, root.scaledScreenWidth - root.width)) }
+        function onYChanged() { if (root.placementStrategy === "free" && !root.pressed) root.targetY = Math.max(0, Math.min(root.configEntry.y, root.scaledScreenHeight - root.height)) }
